  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The student's main action on a surface: highlighter yellow pill.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.86z\"/></svg>New post</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border:0;border-radius:9999px;background:var(--you);color:var(--you-ink);font:600 15px/1 var(--font-mona),system-ui,sans-serif;cursor:pointer;transition:background-color 150ms cubic-bezier(0.25,1,0.5,1),transform 150ms cubic-bezier(0.25,1,0.5,1)}.ds-btn-primary:hover{background:var(--you-hover)}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-btn-primary:disabled{background:var(--surface-3);color:var(--muted);pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default button: quiet surface pill with a hairline ring.",
      "html": "<button class=\"ds-btn-secondary\">Sign in</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:0;border-radius:9999px;background:var(--surface-2);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line);font:600 14px/1 var(--font-mona),system-ui,sans-serif;cursor:pointer;transition:background-color 150ms cubic-bezier(0.25,1,0.5,1),transform 150ms}.ds-btn-secondary:hover{background:var(--surface-3)}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis action beside a primary.",
      "html": "<button class=\"ds-btn-ghost\">How it works</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:0;border-radius:9999px;background:transparent;color:var(--muted);font:600 14px/1 var(--font-mona),system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-ghost:hover{background:var(--surface-3);color:var(--ink)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Resting on surface-2; lifts to surface with a 2px ink (dark: yellow) ring on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"you@university.edu\">",
      "css": ".ds-input{width:100%;height:48px;padding:0 16px;border:0;border-radius:16px;background:var(--surface-2);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line);font:400 15px var(--font-mona),system-ui,sans-serif;transition:box-shadow 150ms,background-color 150ms}.ds-input::placeholder{color:var(--muted)}.ds-input:hover{box-shadow:inset 0 0 0 1px var(--line-strong)}.ds-input:focus{outline:none;background:var(--surface);box-shadow:inset 0 0 0 2px var(--ink)}:host-context(.dark) .ds-input:focus{box-shadow:inset 0 0 0 2px var(--you)}"
    },
    {
      "name": "Topic Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill filters in the sticky header; the active one inverts to ink.",
      "html": "<div class=\"ds-chips\"><a class=\"ds-chip ds-chip-on\" href=\"#\">All</a><a class=\"ds-chip\" href=\"#\">Academics</a><a class=\"ds-chip\" href=\"#\">Campus life</a></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{padding:6px 14px;border-radius:9999px;background:var(--surface);color:var(--muted);box-shadow:inset 0 0 0 1px var(--line);font:600 13px var(--font-mona),system-ui,sans-serif;text-decoration:none;transition:color 150ms}.ds-chip:hover{color:var(--ink)}.ds-chip:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-chip-on,.ds-chip-on:hover{background:var(--ink);color:var(--background);box-shadow:none}"
    },
    {
      "name": "Bilateral Bubbles",
      "kind": "custom",
      "refersTo": "bubble-others",
      "description": "Others left in neutral bubbles with alias hue names; yours right in yellow.",
      "html": "<div class=\"ds-chat\"><div class=\"ds-row\"><span class=\"ds-av\" style=\"--hue:155\">QO</span><div class=\"ds-col\"><span class=\"ds-meta\"><b class=\"ds-name\" style=\"--hue:155\">Quiet Otter</b> · Kestrel Institute</span><p class=\"ds-bubble\">Not just you. Half the people posting offers are panicking too.</p></div></div><div class=\"ds-row ds-mine\"><div class=\"ds-col\"><span class=\"ds-meta\"><b>You</b></span><p class=\"ds-bubble ds-bubble-mine\">Honestly needed to read this today.</p></div></div></div>",
      "css": ".ds-chat{display:flex;flex-direction:column;gap:16px;font-family:var(--font-mona),system-ui,sans-serif}.ds-row{display:flex;align-items:flex-end;gap:8px}.ds-mine{flex-direction:row-reverse}.ds-col{display:flex;flex-direction:column;max-width:72%}.ds-mine .ds-col{align-items:flex-end}.ds-av{display:grid;place-items:center;width:32px;height:32px;flex-shrink:0;border-radius:9999px;font:700 12px var(--font-mona),sans-serif;background:oklch(var(--alias-bg-l) var(--alias-bg-c) var(--hue));color:oklch(var(--alias-fg-l) var(--alias-fg-c) var(--hue))}.ds-meta{margin:0 4px 4px;font-size:12px;color:var(--muted)}.ds-name{font-weight:600;font-size:13px;color:oklch(var(--alias-name-l) var(--alias-name-c) var(--hue))}.ds-mine .ds-meta b{color:var(--ink)}.ds-bubble{margin:0;padding:10px 16px;border-radius:6px 22px 22px 22px;background:var(--surface);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line),var(--shadow-soft);font-size:15px;line-height:1.625;transition:box-shadow 200ms}.ds-bubble:hover{box-shadow:inset 0 0 0 1px var(--line),var(--shadow-pop)}.ds-bubble-mine,.ds-bubble-mine:hover{border-radius:22px 6px 22px 22px;background:var(--you);color:var(--you-ink);box-shadow:none}"
    },
    {
      "name": "Reply Bar",
      "kind": "input",
      "refersTo": "send-button",
      "description": "Thumb-reach composer: rounded shell and a round yellow send button, neutral when empty.",
      "html": "<form class=\"ds-reply\"><input class=\"ds-reply-input\" placeholder=\"Write a reply\"><button class=\"ds-send\" aria-label=\"Send reply\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 7-7 7 7\"/><path d=\"M12 19V5\"/></svg></button></form>",
      "css": ".ds-reply{display:flex;align-items:center;gap:8px;padding:6px;border-radius:26px;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);transition:box-shadow 150ms}.ds-reply:focus-within{box-shadow:inset 0 0 0 2px var(--ink)}.ds-reply-input{flex:1;min-height:40px;padding:8px 12px;border:0;background:transparent;color:var(--ink);font:400 15px var(--font-mona),system-ui,sans-serif;outline:none}.ds-reply-input::placeholder{color:var(--muted)}.ds-send{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:9999px;background:var(--you);color:var(--you-ink);cursor:pointer;transition:transform 150ms,background-color 150ms}.ds-send:active{transform:scale(0.9)}.ds-send:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-send:disabled{background:var(--surface-3);color:var(--muted);cursor:default}"
    },
    {
      "name": "Mobile Tab Bar",
      "kind": "nav",
      "refersTo": "button-primary",
      "description": "Fixed blurred bar with a raised yellow plus at its center.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Feed</a><a class=\"ds-plus\" href=\"#\" aria-label=\"New post\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></a><a class=\"ds-tab\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10.27 21a2 2 0 0 0 3.46 0\"/><path d=\"M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33\"/></svg>Alerts</a></nav>",
      "css": ".ds-tabs{display:flex;align-items:flex-start;height:64px;border-top:1px solid var(--line);background:color-mix(in oklch,var(--background) 85%,transparent);backdrop-filter:blur(24px)}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding-top:8px;color:var(--muted);font:500 11px var(--font-mona),system-ui,sans-serif;text-decoration:none}.ds-tab:hover,.ds-tab-on{color:var(--ink)}.ds-tab:focus-visible,.ds-plus:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-plus{display:grid;place-items:center;width:48px;height:48px;margin:6px auto 0;border-radius:9999px;background:var(--you);color:var(--you-ink);box-shadow:var(--shadow-soft);transition:transform 150ms}.ds-plus:active{transform:scale(0.95)}"
    }
  ],
  "narrative": {
    "northStar": "The Group Chat at the Canteen Table",
    "overview": "Every thread is a group chat where each sender is a verified student wearing a per-thread alias. The interface uses chat-app grammar, not a forum's card feed. Others' messages are neutral bubbles on the left. The student's own messages are highlighter-yellow bubbles on the right. Names come in per-thread hues with initials avatars, and a faint hand-drawn doodle wallpaper sits behind conversations. There are no vote columns, no karma and no photos of real people. The bubbles carry the identity.\n\nThe grounds are cool: a near-white in light mode and a deep ink-graphite in dark mode. Both themes are first-class and built from the same token names. Density is phone-first. Each feed is a single column of bubbles with roughly 15px body text. Navigation, headers and the reply bar stay pinned to the edges, and content scrolls between them.\n\nType comes from one variable family, Mona Sans. Its expanded heavy cut (width 125%, weight 800) is used for display moments, and normal width is used for everything you read and tap. Icons are Lucide line icons. Chips, buttons and the send button are pills or circles.",
    "keyCharacteristics": [
      "Bilateral layout by position: you on the right in yellow, everyone else on the left in neutral bubbles.",
      "Highlighter yellow belongs to the student's own voice and primary actions, and nothing else.",
      "Per-thread alias hues: the alias sets the hue, the theme sets lightness and chroma.",
      "Expanded heavy Mona Sans for display, normal width for UI.",
      "Light and dark are equal citizens. No surface is designed for one theme only.",
      "A doodle wallpaper behind chat areas, tinted by the theme at about 4 to 5% strength."
    ],
    "rules": [
      {
        "name": "The Your Voice Rule",
        "body": "Highlighter yellow means \"this is you, or this is your next move.\" Use it for the student's own messages, primary actions, selection and dark-mode focus. Don't use it for others' content, decorative fills, category colours or status.",
        "section": "colors"
      },
      {
        "name": "The Hue From Alias Rule",
        "body": "Others are identified by an alias hue on their name and avatar, never by a bubble colour. Their bubbles stay neutral `surface`.",
        "section": "colors"
      },
      {
        "name": "The Neutral Disabled Rule",
        "body": "A disabled primary action drops to `surface-3` with `muted` text at full opacity. It is never faded yellow, because yellow must not appear unless the action is available.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "The display cut is only for display text: landing statements, page-header titles and the wordmark. Don't use it for bubble text, buttons or meta text. Width carries the hierarchy, so you don't need more font sizes.",
        "section": "typography"
      },
      {
        "name": "The Ring Plus Soft Rule",
        "body": "Others' bubbles and cards use `surface` + 1px `line` ring + soft shadow. Yellow bubbles use none of these, because their colour already lifts them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** place the student's own content on the right in Highlighter Yellow with Yellow Ink, and everyone else's on the left in neutral `surface` bubbles.",
      "**Do** use exactly one yellow primary action per surface region, such as New post in the rail, the plus in the tab bar, or the send button in a thread.",
      "**Do** colour aliases through `--hue` with the theme's L/C tokens, so both themes stay legible.",
      "**Do** check every new surface in both light and dark mode before it ships.",
      "**Do** use the display cut (width 125%, weight 800, -0.035em) for page-header titles and landing statements, and normal width for everything else.",
      "**Do** show state by shape as well as colour: filled hearts, thicker active icon strokes, inverted active chips.",
      "**Do** respect `prefers-reduced-motion`. Global CSS already collapses animations, and scripted motion must check it too."
    ],
    "donts": [
      "**Don't** use yellow for others' messages, categories, status, illustration fills or decoration.",
      "**Don't** fade a disabled primary button. Switch it to `surface-3` with `muted` text.",
      "**Don't** add vote columns, karma, follower counts, real-person avatars or profile photos. Identity is an alias hue with initials.",
      "**Don't** hard-code alias colours or use a theme-specific hex where a token exists.",
      "**Don't** add tab-bar bottom padding on routes where the tab bar is hidden (threads, composer).",
      "**Don't** set bubble text, buttons or meta text in the expanded display cut."
    ]
  }
}