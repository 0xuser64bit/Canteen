generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (shape required by Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  // Always empty: Canteen never stores real names. Better Auth requires the column.
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  // Always null: Canteen never stores profile photos.
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  universityId String
  university   University @relation(fields: [universityId], references: [id])
  // Suspended accounts may authenticate only for status, appeals and deletion.
  bannedAt     DateTime?

  sessions        Session[]
  accounts        Account[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  reports         Report[]
  moderationCases ModerationCase[]
  notifications   Notification[]
  dailyActivity   DailyActivity[]
  publications    Publication[]
  bookmarks       Bookmark[]
  follows         Follow[]
  pollVotes       PollVote[]

  @@index([universityId])
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Hourly email-code sign-in budgets, keyed by a keyed hash of the address or by
// campus domain. No address, code or network detail; maintenance removes rows
// once their hour has passed. (Better Auth prunes RateLimit within a minute.)
model SignInBudget {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ---------------------------------------------------------------------------
// Canteen
// ---------------------------------------------------------------------------

// Created lazily the first time someone from that university signs up.
// Source of truth for which domains map to which university is data/universities.json.
model University {
  id          String   @id @default(cuid())
  // Primary email domain from the dataset; stable even if the dataset is reordered.
  domain      String   @unique
  slug        String   @unique
  name        String
  country     String
  countryCode String
  website     String?
  createdAt   DateTime @default(now())

  users User[]
  posts Post[]
}

enum PublicationKind {
  POST
  COMMENT
  UPLOAD
}

// Bounded anti-abuse state survives content deletion, and erases with the account.
model Publication {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PublicationKind
  createdAt DateTime        @default(now())

  @@index([userId, kind, createdAt])
  @@index([createdAt])
}

enum Topic {
  GENERAL
  ACADEMICS
  CAMPUS_LIFE
  CAREERS
  MENTAL_HEALTH
  OPPORTUNITIES
}

enum PostKind {
  DISCUSSION
  QUESTION
}

enum Audience {
  // Visible to every verified student.
  EVERYONE
  // Visible only to students of the author's university.
  CAMPUS
}

model Post {
  id             String         @id @default(cuid())
  title          String
  body           String
  imageUrl       String?
  imageAlt       String?
  imageWidth     Int?
  imageHeight    Int?
  applicationUrl String?
  deadline       DateTime?
  revision       Int            @default(0)
  kind           PostKind       @default(DISCUSSION)
  helpfulAnswer  HelpfulAnswer?
  topic          Topic          @default(GENERAL)
  audience       Audience       @default(EVERYONE)
  // Set when enough distinct students report it; hidden posts never reach feeds.
  removedAt      DateTime?
  hiddenAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // The author's university when posting; denormalized so feeds never join through users.
  universityId String
  university   University @relation(fields: [universityId], references: [id])

  comments        Comment[]
  likes           Like[]
  views           PostView[]
  reports         Report[]
  moderationCases ModerationCase[]
  notifications   Notification[]
  pollOptions     PollOption[]
  bookmarks       Bookmark[]
  follows         Follow[]
  pollVotes       PollVote[]

  @@index([createdAt])
  @@index([universityId, createdAt])
  @@index([topic, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  removedAt DateTime?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  helpfulAnswer   HelpfulAnswer?
  moderationCases ModerationCase[]
  reports         Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model Like {
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
}

// A post's poll: two to four choices, in order.
model PollOption {
  id       String @id @default(cuid())
  label    String
  position Int

  postId String
  post   Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@unique([postId, position])
}

// One vote per student per poll; voting again moves it. Only totals ever leave the server.
model PollVote {
  createdAt DateTime @default(now())

  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId   String
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([optionId])
}

// One marker per student who opened a post, so refreshing can't inflate view
// counts. `viewer` is a keyed hash of account and post, never the account id,
// so the database holds no reading list.
model PostView {
  viewer String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, viewer])
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  PERSONAL_INFO
  SELF_HARM
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  createdAt  DateTime     @default(now())
  // Set when a moderator reviews it; only open reports count toward hiding.
  resolvedAt DateTime?

  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([postId])
  @@index([commentId])
}

enum NotificationType {
  COMMENT
  LIKE
}

// Notifications never say who acted; that would break anonymity.
model Notification {
  revision  Int              @default(0)
  replyId   String?
  id        String           @id @default(cuid())
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Independent of posts/users so erasure survives account deletion and storage outages.
model BlobDeletion {
  id          String    @id @default(cuid())
  key         String    @unique
  dueAt       DateTime  @default(now())
  attempts    Int       @default(0)
  lockedUntil DateTime?

  @@index([dueAt])
}

// Operational heartbeat only: no student identifiers or content.
model Maintenance {
  id          String    @id
  startedAt   DateTime
  succeededAt DateTime?
  failedAt    DateTime?
}

model UniversityRequest {
  id         String    @id @default(cuid())
  domain     String    @unique
  website    String
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  accepted   Boolean?

  @@index([reviewedAt, createdAt])
}

// Only the question's author chooses a helpful answer; deleting it reopens the question.
model HelpfulAnswer {
  postId    String   @id
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String   @unique
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Private collections. Only booleans for the current viewer leave the server.
model Bookmark {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

enum ModerationDecision {
  KEEP
  REMOVE
  BAN
}

// Reporter identity is never part of a decision or appeal view.
model ModerationCase {
  id         String             @id @default(cuid())
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId  String?
  comment    Comment?           @relation(fields: [commentId], references: [id], onDelete: SetNull)
  decision   ModerationDecision
  reason     ReportReason
  createdAt  DateTime           @default(now())
  appealText String?
  appealedAt DateTime?
  resolvedAt DateTime?
  restored   Boolean?
  response   String?

  @@index([authorId, createdAt])
  @@index([appealedAt, resolvedAt])
}

// One first-party activity mark per student and UTC day, erased with the account.
model DailyActivity {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
  @@index([day])
}
