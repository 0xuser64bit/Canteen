# Copy to .env and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required
# for local development; everything else switches optional features on.

# Postgres connection string. On Vercel use the pooled URL from your provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canteen"

# Signs sessions and derives per-thread aliases. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the site. Optional on Vercel (derived automatically) and in local dev.
# BETTER_AUTH_URL="https://canteen.example.com"

# Email sign-in codes via Resend (https://resend.com). Without a key, development
# prints codes to the server console and production hides email sign-in.
# RESEND_API_KEY=""
# EMAIL_FROM="Canteen <login@your-domain.com>"

# Optional "Continue with Google" for university Google Workspace accounts.
# Redirect URI: <site url>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional image uploads via Vercel Blob. Without it, posts are text-only.
# BLOB_READ_WRITE_TOKEN=""
