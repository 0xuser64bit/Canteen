# Copy to .env and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required
# for local development; everything else switches optional features on.

# Postgres connection string. On Vercel use the pooled URL from your provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canteen"
# Direct (non-pooled) connection used by `prisma migrate`. Only needed when
# DATABASE_URL points at a connection pooler, as with Neon on Vercel.
# DATABASE_URL_UNPOOLED=""

# Signs sessions and derives per-thread aliases. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the site. Optional on Vercel (derived automatically) and in local dev.
# BETTER_AUTH_URL="https://canteen.example.com"

# Email sign-in codes via Resend (https://resend.com). Without a key, development
# prints codes to the server console and production hides email sign-in.
# RESEND_API_KEY=""
# EMAIL_FROM="Canteen <login@your-domain.com>"

# Optional "Continue with Google" for Google accounts with a verified university email.
# Redirect URI: <site url>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Private Vercel Blob store for new image uploads.
# BLOB_PRIVATE_READ_WRITE_TOKEN=""
# Old public store token, only for migrating and erasing existing files.
# BLOB_READ_WRITE_TOKEN=""
# Protects scheduled cleanup. Generate with: openssl rand -hex 32
# CRON_SECRET=""

# Optional staff accounts that can join without a university email, comma-separated.
# Everything they post is labeled "Canteen team".
# TEAM_EMAILS="you@example.com"

# Optional team alerts: a Slack, Discord or other webhook that accepts a `text`
# field. Pages the team about at-risk reports, content hidden by reports, new
# appeals and failed maintenance. Messages never carry content or identities.
# OPS_ALERT_WEBHOOK_URL=""

# Optional campus hosts. An account must also belong to TEAM_EMAILS and the team
# university. Each assignment grants discussion access only to the listed campus
# domains; use canonical primary domains from data/universities.json. Omit for no
# host access. Choose real owners and disclose coverage before enabling.
# CAMPUS_HOSTS='{"you@example.com":["stanford.edu"]}'
